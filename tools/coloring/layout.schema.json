{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Компоновка художественного листа 1.0",
  "type": "object",
  "required": ["schema_version", "page", "artwork_panel", "legend"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "page": {"type": "object", "required": ["width", "height", "unit", "margin"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "px"}, "margin": {"type": "number", "minimum": 0}}},
    "artwork_panel": {"$ref": "#/$defs/panel"},
    "legend": {"allOf": [{"$ref": "#/$defs/panel"}, {"type": "object", "required": ["columns", "swatch_size", "font_size", "font_family", "gap"], "properties": {"columns": {"type": "integer", "minimum": 1}, "swatch_size": {"type": "number", "exclusiveMinimum": 0}, "font_size": {"type": "number", "exclusiveMinimum": 0}, "font_family": {"type": "string", "minLength": 1}, "gap": {"type": "number", "exclusiveMinimum": 0}, "overflow": {"const": "new_page"}}}]},
    "title": {"type": "string"}, "notes": {"type": "string"},
    "print_profile": {"type": "object", "properties": {"physical_1_to_1": {"const": false}}}
  },
  "$defs": {"panel": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "fit": {"const": "contain"}, "allow_distortion": {"const": false}}}}
}
